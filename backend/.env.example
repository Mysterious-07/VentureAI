# ---------------------------------------------------------
# VentureAI Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://ventureai_user:ventureai_pass@localhost:5432/ventureai

# JWT secrets — generate strong random values in production
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to "true" only when serving over HTTPS in production
COOKIE_SECURE=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Google Gemini AI key (required for idea validation, BMC, pitch deck, business plan)
GEMINI_API_KEY=
